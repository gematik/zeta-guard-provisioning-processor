@Library('gematik-jenkins-shared-library') _

String TEAMS_NOTIFICATION_CHANNEL = "19:0bkQbT0DRoXwnnOUFNQ51vogrSZuNDtTkEybSBcyPYg1@thread.tacv2"
String TEAMS_NOTIFICATION_GROUP_ID = "8ac3172b-1f33-4c44-8ce2-d39a5e19350a"

pipeline {

    options {
        disableConcurrentBuilds()
        buildDiscarder logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '', daysToKeepStr: '', numToKeepStr: '5')
    }
    agent { label 'k8-backend-small' }

    stages {

        stage('OSPO Guidelines') {
            steps {
                script {
                    try {
                        openSourceGuidelineCheck()
                    } catch (Exception e) {
                        unstable("OSPO Guidelines check failed: ${e.message}" )
                    }
                }
            }
        }
    }
    post {
        always {
            teamsSendNotificationToChannel(TEAMS_NOTIFICATION_CHANNEL, TEAMS_NOTIFICATION_GROUP_ID)
        }
    }
}
